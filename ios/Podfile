# CocoaPods dependencies for Screact (iOS).
#
# The Xcode project is generated by XcodeGen (`xcodegen generate`) and builds WITHOUT these pods
# (MediaPipe / OpenCV code is guarded by `#if canImport(...)` / `__has_include(...)`). Installing
# the pods enables real hand detection and ArUco marker detection — no Swift changes required.
#
# Usage:
#   cd ios
#   xcodegen generate           # produces Screact.xcodeproj
#   pod install                 # produces Screact.xcworkspace + links the pods below
#   open Screact.xcworkspace    # build & run from the workspace after this point

platform :ios, '15.0'

target 'Screact' do
  use_frameworks!

  # MediaPipe Tasks Vision (HandLandmarker, 21 landmarks) — same model family as Android.
  pod 'MediaPipeTasksVision'

  # OpenCV for iOS — provides the ArUco DICT_4X4_50 detector used by ArucoBridge.mm.
  # The 'OpenCV' pod vendors opencv2.framework and exposes the C++ headers used by the ObjC++ bridge.
  pod 'OpenCV', '~> 4.9'
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
