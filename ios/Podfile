# CocoaPods dependencies for Screact (iOS).
#
# The Xcode project is generated by XcodeGen (`xcodegen generate`) and builds WITHOUT this pod
# (MediaPipe code is guarded by `#if canImport(MediaPipeTasksVision)`). Installing the pod enables
# real hand detection — no Swift changes required.
#
# OpenCV (for the ArUco DICT_4X4_50 detector in ArucoBridge.mm) is NOT a CocoaPod: the `OpenCV`
# trunk pod tops out at 4.3.0, which lacks the `cv::aruco::ArucoDetector` API (moved into the core
# `objdetect` module in OpenCV 4.7). OpenCV 4.9 is therefore pulled in as a Swift Package
# (github.com/yeatse/opencv-spm) declared in `project.yml`. `pod install` only wires MediaPipe.
#
# Usage:
#   cd ios
#   xcodegen generate           # produces Screact.xcodeproj (resolves the OpenCV Swift Package)
#   pod install                 # produces Screact.xcworkspace + links MediaPipe
#   open Screact.xcworkspace    # build & run from the workspace after this point

platform :ios, '15.0'

target 'Screact' do
  use_frameworks!

  # MediaPipe Tasks Vision (HandLandmarker, 21 landmarks) — same model family as Android.
  pod 'MediaPipeTasksVision'
end

post_install do |installer|
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
